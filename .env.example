# Superbooth configuration. Copy to .env.local and fill in.
# Full walkthrough: SETUP.md

# ---------------------------------------------------------------------------
# Local development
# ---------------------------------------------------------------------------
# With FAL_MOCK=1 the booth generates images locally and stores data in a file,
# so the whole flow runs with no accounts and no cost. Remove it for real
# generation.
FAL_MOCK=1

# Absolute origin the QR code points at. Get this wrong in production and every
# guest is sent to the wrong place.
APP_URL=http://localhost:3000

# Unlocks the hidden staff menu on the kiosk (five taps, top-right corner).
# Change it before an event.
ATTENDANT_PIN=1234

# ---------------------------------------------------------------------------
# FAL — image generation
# ---------------------------------------------------------------------------
# From https://fal.ai. Server-side only; never reaches the browser.
# FAL_KEY=

# ---------------------------------------------------------------------------
# Firebase — persistence and admin sign-in
# ---------------------------------------------------------------------------
# Without these, data is stored locally and /admin uses the PIN above. The PIN
# fallback is disabled in production, so a deployment needs these set.
#
# Server credentials, from the service account JSON:
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# Keep the literal \n sequences and the surrounding double quotes:
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# Browser credentials, from the web app config. These are not secrets.
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Who may reach /admin. An empty list locks everyone out.
# ADMIN_EMAILS=you@example.com

# ---------------------------------------------------------------------------
# Scheduled jobs
# ---------------------------------------------------------------------------
# Required bearer token for /api/cron/purge, so only Vercel Cron can trigger it.
# CRON_SECRET=
