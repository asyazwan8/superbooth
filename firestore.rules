rules_version = '2';

// Superbooth stores nothing that a browser should read or write directly.
//
// Every read and write goes through the Next.js server, using the Admin SDK —
// which is what lets one place own input validation, the admin allowlist, and
// PDPA retention. Opening any of this to the client would mean a guest at the
// kiosk could read other guests' names and email addresses, since the kiosk is
// a public, unauthenticated machine.
//
// The Admin SDK bypasses these rules by design, so denying everything here
// costs the application nothing and closes the browser off completely.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
